# Skip Hugging Face Hub's online "check for newer revision" call on startup.
# Needed once the model is already cached locally — without this, startup can
# hang for a long time on environments with broken/unreachable IPv6 (the Hub
# client tries an online check before falling back to the local cache).
HF_HUB_OFFLINE=1
STT_MODEL_ID=deepdml/faster-whisper-large-v3-turbo-ct2
DEVICE=cuda
COMPUTE_TYPE=float16
MAX_CONCURRENT_TRANSCRIPTIONS=4
MAX_FILE_SIZE_MB=200
JOB_RESULT_TTL_SECONDS=3600
MAX_PENDING_JOBS=100
STT_API_KEY=changeme-please-set-STT_API_KEY
HOST=0.0.0.0
PORT=8000
